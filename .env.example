# Required. The app refuses to start without it, on purpose: a default secret is
# worse than no app.
JWT_SECRET=change-me-openssl-rand-hex-32

# The transport validates the Host header against DNS rebinding and refuses every
# name it does not know. Without this, MCP looks broken and nothing says why —
# and it cannot be reproduced from the machine itself, because on 127.0.0.1 the
# same call works.
PUBLIC_URL=https://thelist.borant.eu

# local | gateway. `local` is the default and stays a working way back in.
AUTH_MODE=local
# In gateway mode, identity headers are believed only from here. Under Docker
# this is the bridge gateway and NOT 127.0.0.1 — read the real value off the
# running container (DEPLOY.md).
BORANT_TRUSTED_PROXY=172.17.0.1

# First account, created by seed.py. Only used in local mode.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Mail is a degradable dependency: with SMTP_ENABLED unset the app behaves
# exactly the same and invitation links are shown on screen.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=TheList
